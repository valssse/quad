{
  "name": "quad-promo-video",
  "private": true,
  "version": "1.0.0",
  "description": "Video promocional de Quad v3 (63 s, 1920x1080, 30 fps) hecho con Remotion",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts QuadPromo out/quad-promo.mp4 --crf=16",
    "audio": "python3 audio/make_audio.py",
    "render:vertical": "remotion render src/index.ts QuadPromoVertical out/quad-promo-vertical.mp4 --crf=16"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.546",
    "@remotion/renderer": "^4.0.546",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.546"
  }
}